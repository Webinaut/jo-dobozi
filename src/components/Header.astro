---
import { Image } from "astro:assets";
import ContactButton from "../components/ContactButton.astro";
import jopic from "../images/Jo.png";
---

<div class="container-fluid contact-button">
  <ContactButton />
</div>

<div class="container-fluid header-grid">
  <div class="hero1">
    <h1>Jo</h1>
  </div>
  <div class="hero2">
    <h1>Dobozi</h1>
  </div>
  <div class="image_top">
    <Image src={jopic} alt="Jo Dobozi" />
  </div>
</div>

<style lang="scss">
  .container-fluid {
    &.header-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: minmax(10px, auto);
      background: #425e5e;
      background: linear-gradient(
        180deg,
        rgba(66, 94, 94, 0.79) 0%,
        rgba(128, 168, 121, 0.8) 35%
      );
      background-size: cover;
      padding: 20px 0 0 20px;
    }
  }
  .main-nav {
    background-color: transparent;
  }
  h1 {
    font-size: 12vw;
    line-height: 0.9em;
    text-transform: lowercase;
    margin: 0;
  }
  .hero1 {
    grid-area: 2 / 2 / 3 / span 12;
    justify-self: start;
  }
  .hero2 {
    grid-area: 3 / 2 / 4 / span 12;
    justify-self: start;
    margin-bottom: 1em;

    & h1 {
      padding-left: 0.28em;
    }
  }
  .image_top {
    img {
      filter: grayscale(1);
      max-height: 90vh;
      width: 30vw;
      height: auto;
    }

    grid-area: 1 / 9 / span 3 / span 4;
    justify-self: end;
  }
  .container-fluid.contact-button {
    display: flex;
    justify-content: flex-start;
    position: fixed;
    top: 0;
    z-index: 10;
    background-color: transparent;
  }
</style>
